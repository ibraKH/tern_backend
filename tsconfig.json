{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "types": ["node", "jest"],
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "jest.setup.ts"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "files": true
  }
}
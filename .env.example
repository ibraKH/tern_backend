# ─────────────────────────────────────────────────────────────────────────────
# TERN Backend — Environment Variables
# Copy this file to .env and fill in the values before running the server.
# All variables marked REQUIRED must be set or the server will fail to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# REQUIRED in production (DigitalOcean sets this automatically).
# OPTIONAL in development — defaults to 3000 if omitted.
PORT=3000

# Runtime environment. Controls email requirements, CORS dev origins, etc.
# REQUIRED. Values: "development" | "production" | "test"
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string.
# REQUIRED. Example: postgres://user:password@localhost:5432/tern_db
# Production value is injected by DigitalOcean App Platform from the
# attached managed database component.
DATABASE_URL=postgres://user:password@localhost:5432/tern_db

# Individual PostgreSQL connection parameters.
# REQUIRED for local development (used by node-pg-migrate dev config and docker-compose).
# In production, only DATABASE_URL above is used.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DB=tern

# ── Auth / JWT ────────────────────────────────────────────────────────────────

# Secret used to sign and verify JWT access tokens.
# REQUIRED. Use a long random string (32+ characters).
# Changing this value invalidates ALL existing tokens.
JWT_SECRET=change-me-to-a-long-random-secret

# JWT expiry duration (jsonwebtoken format: "1d", "12h", "30m", etc.).
# REQUIRED. Recommended: "1d" for dev, "2h" for production.
JWT_EXPIRES=1d

# JWT issuer claim — identifies who issued the token. Must match on sign and verify.
# OPTIONAL — defaults to "tern-backend" if omitted.
JWT_ISSUER=tern-backend

# JWT audience claim — identifies the intended recipient. Must match on sign and verify.
# OPTIONAL — defaults to "tern-api" if omitted.
JWT_AUDIENCE=tern-api

# ── Password Hashing ──────────────────────────────────────────────────────────

# Number of bcrypt salt rounds. Higher = slower but more secure.
# REQUIRED. Recommended: 12 for production, 4 for faster tests.
BCRYPT_SALT_ROUNDS=12

# Server-side pepper prepended to passwords before hashing.
# REQUIRED. Use a long random string (32+ characters).
# Changing this value invalidates ALL existing password hashes.
BCRYPT_PEPPER=change-me-to-a-long-random-pepper

# ── CORS / Frontend URLs ──────────────────────────────────────────────────────

# URL of the React frontend. Used for CORS allowed origins and 404 redirects.
# REQUIRED. Example: http://localhost:5173 (dev) or https://your-frontend.app (prod)
FRONTEND_URL=http://localhost:5173

# URL of the production backend (used in Swagger server list and CORS).
# OPTIONAL — defaults to the DigitalOcean app URL if not set.
# PRODUCTION_URL=https://your-production-url.com

# ── Email (Gmail SMTP via Nodemailer) ─────────────────────────────────────────

# Gmail address used to send verification emails.
# REQUIRED in production (NODE_ENV=production).
# OPTIONAL in development — email features are silently skipped if omitted.
# Generate an App Password at: Google Account → Security → 2FA → App Passwords
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (not your regular Gmail password).
# REQUIRED in production (NODE_ENV=production).
# OPTIONAL in development.
GMAIL_APP_PASSWORD=your-google-app-password

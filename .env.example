# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=1d

# Hashing
BCRYPT_SALT_ROUNDS=12
BCRYPT_PEPPER=change-me-to-a-long-random-pepper

# Database
DATABASE_URL=postgres://user:password@localhost:5432/tern_db

# CORS / URLs
FRONTEND_URL=http://localhost:5173
# PRODUCTION_URL=https://your-production-url.com  # optional, defaults to DigitalOcean URL

# Email (required in production; optional in development — email features will be disabled if omitted)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
